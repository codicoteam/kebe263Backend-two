# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/superapp_zw

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Email (Nodemailer — use Gmail App Password or SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=SuperApp ZW <noreply@superappzw.co.zw>

# OTP
OTP_EXPIRY_MINUTES=10

# PayNow Zimbabwe
PAYNOW_INTEGRATION_ID=your_paynow_integration_id
PAYNOW_INTEGRATION_KEY=your_paynow_integration_key
PAYNOW_RESULT_URL=https://yourdomain.co.zw/api/payments/paynow/result
PAYNOW_RETURN_URL=https://yourdomain.co.zw/payment/success

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
